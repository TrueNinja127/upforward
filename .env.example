# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://upforward.org

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" key on older projects, "publishable" key (sb_publishable_…) on newer ones.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key on older projects, "secret" key (sb_secret_…) on newer ones.
# Server only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin inbox (/admin) -----------------------------------------------------
# Password used to sign in at /admin/login. Use a long random string.
ADMIN_PASSWORD=
# Secret used to sign admin sessions and derive private realtime channel names.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Optional: search engine verification -------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Email via Resend (sign-in links + unread message notifications) ----------
# https://resend.com → API Keys. Without it, email features are disabled.
RESEND_API_KEY=
# Sender address on a domain you verified in Resend, e.g. "Upforward <hello@upforward.org>".
# Leave empty while testing: onboarding@resend.dev can only email your own Resend account address.
EMAIL_FROM=
# Optional: where to email the admin about new applications and unread applicant messages.
ADMIN_NOTIFICATION_EMAIL=
# Seconds a message may stay unread before an email goes out (default 20).
UNREAD_NOTIFY_DELAY_SECONDS=20
