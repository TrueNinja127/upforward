# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://upforward.org

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" key on older projects, "publishable" key (sb_publishable_…) on newer ones.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key on older projects, "secret" key (sb_secret_…) on newer ones.
# Server only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin inbox (/admin) -----------------------------------------------------
# Password used to sign in at /admin/login. Use a long random string.
ADMIN_PASSWORD=
# Secret used to sign admin sessions and derive private realtime channel names.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Optional: search engine verification -------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
