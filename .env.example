# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://upforward.org
# The admin panel (jobs are managed and applicant chats answered there). Used in links.
ADMIN_URL=https://admin.upforward.org

# --- Supabase: the SAME project as the admin panel ----------------------------
# Project Settings → API of the admin panel's Supabase project (tnboard/.env → SUPABASE_URL).
# Jobs, applications, chat messages and attachments live in that project; the panel creates the tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" key on older projects, "publishable" key (sb_publishable_…) on newer ones.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key on older projects, "secret" key (sb_secret_…) on newer ones.
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: search engine verification -------------------------------------
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Email via Resend: the SAME account/domain as the admin panel ---------------
# Sends applicants their chat sign-in links and alerts the team about applicants.
# Without it, email sign-in and the alert emails are disabled; the rest keeps working.
RESEND_API_KEY=
# Sender address on the verified domain, e.g. "Upforward <hello@email.upforward.org>".
# Leave empty while testing: onboarding@resend.dev can only email your own Resend account address.
EMAIL_FROM=
# Optional: also email this address about new applications and applicant messages that
# stay unread (the admin panel always shows them in its notification bell).
ADMIN_NOTIFICATION_EMAIL=
# Seconds an applicant message may stay unread before the alert email goes out (default 20).
UNREAD_NOTIFY_DELAY_SECONDS=20

# --- Web Push: the SAME key pair as the admin panel -----------------------------
# Generate once with `npx web-push generate-vapid-keys` and put the same values in the
# panel (VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY). Applicants get a push when the team
# replies; the team gets one when someone applies or writes. Works with the site closed.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@upforward.org
